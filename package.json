{
  "name": "openmeteo-weather-widget",
  "repository": {
    "type": "git",
    "url": "https://github.com/kotsiossp97/weather-widget.git"
  },
  "version": "0.0.2",
  "description": "Framework-agnostic weather widget with ESM, CJS, and CDN bundles.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/weather-widget.umd.js",
  "jsdelivr": "./dist/weather-widget.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "generate:meteocons": "node scripts/generate-meteocon-loaders.mjs",
    "predev": "npm run generate:meteocons",
    "dev": "vite",
    "prebuild": "npm run generate:meteocons",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "lint:scripts": "eslint . --ext .ts",
    "lint:styles": "stylelint ./**/*.{css,scss}",
    "format:scripts": "prettier . --write",
    "format:styles": "stylelint ./**/*.{css,scss} --fix",
    "format": "npm run format:scripts && npm run format:styles"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.99.0",
    "stylelint": "^17.6.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.4"
  },
  "dependencies": {
    "@meteocons/svg": "^0.1.0",
    "@meteocons/svg-static": "^0.1.0"
  }
}
